<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />

    <application
        android:label="Test Nav"
        android:icon="@drawable/ic_flag"
        android:theme="@style/TestNavTheme">

        <meta-data android:name="androidx.car.app.minCarApiLevel" android:value="1" />

        <service
            android:name=".TestNavService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
            <!-- "Navigate to" links, as Android Auto requires of navigation apps: with the navigation
                 templates permission, this makes F-Auto treat it as a navigation app (dashboard map). -->
            <intent-filter>
                <action android:name="androidx.car.app.action.NAVIGATE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="geo" />
            </intent-filter>
        </service>
    </application>
</manifest>
